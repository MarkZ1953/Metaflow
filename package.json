{
  "name": "metaflow",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "node scripts/run-tauri.mjs",
    "desktop:dev": "node scripts/run-tauri.mjs dev",
    "desktop:build": "node scripts/run-tauri.mjs build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "rust": "node scripts/run-rust.mjs",
    "test:rust": "node scripts/run-rust.mjs test --locked",
    "check:rust": "node scripts/run-rust.mjs clippy --all-targets --locked -- -D warnings",
    "format": "prettier --write src scripts docs *.json *.ts *.js *.html *.md"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hookform/resolvers": "^5.2.2",
    "@mui/icons-material": "^7.3.0",
    "@mui/material": "^7.3.0",
    "@tanstack/react-virtual": "^3.13.0",
    "@tauri-apps/api": "^2.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.62.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
